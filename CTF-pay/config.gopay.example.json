{
  "gopay": {
    "_comment": "GoPay 支付。YOUR_* 的 pin/phone_number 可从环境变量读取：WEBUI_GOPAY_PIN/GOPAY_PIN、WEBUI_GOPAY_PHONE/GOPAY_PHONE_NUMBER。默认不填 otp 时回退 CLI；WebUI 会注入 OTP HTTP endpoint。",
    "country_code": "62",
    "phone_number": "YOUR_PHONE_NUMBER",
    "pin": "YOUR_6_DIGIT_GOPAY_PIN",
    "otp": {
      "source": "auto",
      "timeout": 300,
      "interval": 1,
      "code_regex": "(?<!\\d)(\\d{6})(?!\\d)",
      "issued_after_slack_s": 15
    }
  },
  "fresh_checkout": {
    "auth": {
      "cookie_header": "",
      "session_token": "",
      "access_token": "",
      "device_id": "",
      "mode": "access_token"
    }
  },
  "runtime": {
    "confirm_mode": "shared_payment_method",
    "version": "fed52f3bc6",
    "js_checksum": "FILL_FROM_CURRENT_STRIPE_CHECKOUT",
    "rv_timestamp": "FILL_FROM_CURRENT_STRIPE_CHECKOUT"
  },
  "proxy": ""
}